<text x="340.0" y="813" font-family="-apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif" font-size="11" fill="#94A3B8" text-anchor="middle">0%</text>
<line x1="554.5" y1="245" x2="554.5" y2="795" stroke="#E2E8F0" stroke-width="1" stroke-dasharray="2 3"/>
<text x="554.5" y="813" font-family="-apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif" font-size="11" fill="#94A3B8" text-anchor="middle">10%</text>
